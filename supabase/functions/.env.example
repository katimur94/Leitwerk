# Secrets für Edge Functions.
# Lokal:  supabase functions serve --env-file supabase/functions/.env
# Hosted: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY werden von Supabase automatisch injiziert.

# Pepper für Runner-Token-Hashes (SHA-256(pepper:token)).
# Einmal generieren (z. B. `openssl rand -hex 32`) und NIE ändern —
# sonst werden alle gepairten Runner ungültig.
RUNNER_TOKEN_PEPPER=

# Ab Phase 1 (oauth-gmail):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
