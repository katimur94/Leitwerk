# Basis-URL der Supabase Edge Functions (für `leitwerk-runner init`).
# Lokal (supabase start):
LEITWERK_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
# Hosted: https://<project-ref>.supabase.co/functions/v1

# Optional: Pfad/Name der Claude-CLI (Standard: "claude")
# LEITWERK_CLAUDE_BIN=claude

# Optional: nur für Provider anthropic_api (eigener API-Key statt Max-Abo)
# ANTHROPIC_API_KEY=
# LEITWERK_ANTHROPIC_MODEL=claude-opus-4-8

# Optional: abweichendes Config-Verzeichnis (Standard: ~/.leitwerk-runner)
# LEITWERK_CONFIG_DIR=
